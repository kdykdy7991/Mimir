{
  "capability_resource": "rag://server/capabilities",
  "contract": "mcp-readonly",
  "contract_version": "v1",
  "errors": [
    "invalid_request",
    "not_found_or_not_accessible",
    "upstream_timeout",
    "upstream_unavailable",
    "rate_limited",
    "overloaded"
  ],
  "evidence": {
    "content_types": [
      "text"
    ],
    "matched_queries": {
      "alternate_max": 3,
      "current_max": 4
    },
    "score_stages": [
      "dense",
      "sparse",
      "fusion",
      "rerank"
    ]
  },
  "evidence_contract": "evidence-v1",
  "features": {
    "alternate_queries": true,
    "answer_generation": false,
    "chunk_context": true,
    "chunk_context_resources": true,
    "get_chunk": true,
    "governance_filters": true,
    "list_documents": true,
    "multi_collection_search": true,
    "multi_query": true,
    "parent_child_chunks": true,
    "search_chunks": true,
    "source_assets": true,
    "write_tools": false
  },
  "filters": {
    "dimensions_defined": [
      "collection",
      "document",
      "tag",
      "folder",
      "file",
      "content",
      "source",
      "time"
    ],
    "enforced_by_tools": true,
    "tag_operators": [
      "and",
      "or"
    ]
  },
  "limits": {
    "alternate_query_max_count": 3,
    "alternate_query_total_max_chars": 3000,
    "collection_max_count": 20,
    "max_content_chars": 8000,
    "max_evidence_count": 50,
    "max_preview_chars": 200,
    "max_structured_chars": 200000,
    "page_size_default": 20,
    "page_size_max": 50,
    "query_max_length": 2000,
    "search_candidate_work_max": 1000,
    "top_k_default": 10,
    "top_k_max": 50
  },
  "pagination": {
    "page_size": {
      "default": 20,
      "max": 50,
      "min": 1
    },
    "top_k": {
      "default": 10,
      "max": 50,
      "min": 1
    }
  },
  "read_only": true,
  "resource_templates": [
    "rag://documents/{document_id}/chunks/{chunk_id}",
    "rag://documents/{document_id}/assets/{asset_id}"
  ],
  "retrieval": {
    "modes": [
      "hybrid",
      "dense",
      "sparse"
    ],
    "rerank": {
      "backend": "none",
      "enabled": false
    }
  },
  "tools": [
    {
      "lifecycle": "long_term",
      "name": "query_knowledge_hub",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "list_collections",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "get_document",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "compat_alias",
      "name": "get_document_summary",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "get_document_chunks",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "list_documents",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "get_chunk",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "search_chunks",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "get_chunk_context",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "list_data_sources",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "get_sync_status",
      "structured_output": true,
      "version": "v1"
    },
    {
      "lifecycle": "long_term",
      "name": "list_sync_failures",
      "structured_output": true,
      "version": "v1"
    }
  ],
  "transports": [
    "stdio",
    "streamable-http"
  ],
  "unsupported": [
    {
      "id": "write_tools",
      "planned_in": null,
      "status": "excluded_by_architecture"
    },
    {
      "id": "answer_generation",
      "planned_in": null,
      "status": "excluded_by_architecture"
    }
  ],
  "warnings": [
    "truncated",
    "rerank_degraded",
    "legacy_metadata_missing",
    "partial_collection_failure"
  ]
}
