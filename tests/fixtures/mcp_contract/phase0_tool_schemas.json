    "query_knowledge_hub": {
      "description": "Search an authorized SKDY knowledge base and return ranked retrieval evidence (chunks + citations). Returns NO answer — the evidence is for your own synthesis. Use list_collections first to identify the collection name.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "collection": {
            "default": "default",
            "description": "Collection name (= BM25 index name) to query.",
            "type": "string"
          },
          "no_rerank": {
            "default": false,
            "description": "Deprecated alias for `rerank`. Use `rerank` instead.",
            "type": "boolean"
          },
          "query": {
            "description": "The text to retrieve evidence for. Up to 2000 characters.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "rerank": {
            "default": true,
            "description": "Whether to apply the optional rerank stage when one is configured. Highly recommended for precision.",
            "type": "boolean"
          },
          "top_k": {
            "default": 10,
            "description": "Maximum number of evidence results to return.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "query_knowledge_hub",
      "output_schema": {
        "properties": {
          "citations": {
            "description": "Deprecated alias for `evidence`.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "collection": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "diagnostics": {
            "properties": {
              "degraded": {
                "type": "boolean"
              },
              "reasons": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "trace_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "degraded",
              "reasons"
            ],
            "type": "object"
          },
          "evidence": {
            "items": {
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "rank": {
                  "type": "integer"
                },
                "score": {
                  "type": "number"
                },
                "source": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "rank",
                "chunk_id",
                "document_id",
                "source",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "n_results": {
            "description": "Deprecated alias for `count`.",
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "collection",
          "count",
          "evidence",
          "diagnostics"
        ],
        "type": "object"
      }
    },
