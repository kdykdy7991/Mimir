    "get_chunk_context": {
      "description": "Read bounded parent and neighboring context for one authorized chunk.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "default": 1,
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "before": {
            "default": 1,
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "chunk_id": {
            "minLength": 1,
            "type": "string"
          },
          "document_id": {
            "minLength": 1,
            "type": "string"
          },
          "include": {
            "default": "both",
            "enum": [
              "parent",
              "neighbors",
              "both"
            ],
            "type": "string"
          },
          "max_chars": {
            "default": 12000,
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "document_id",
          "chunk_id"
        ],
        "type": "object"
      },
      "name": "get_chunk_context",
      "output_schema": {
        "properties": {
          "document_id": {
            "type": "string"
          },
          "hit": {
            "type": "object"
          },
          "neighbors": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "parent": {
            "type": [
              "object",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "document_id",
          "hit",
          "parent",
          "neighbors",
          "truncated"
        ],
        "type": "object"
      }
    },
