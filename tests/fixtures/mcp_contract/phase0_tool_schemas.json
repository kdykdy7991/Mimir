{
  "behavior_samples": {
    "get_document_summary_not_found": {
      "is_error": true,
      "message": "document not found or not accessible"
    },
    "list_collections_empty_state": {
      "markdown_has_no_collections": true,
      "structured": {
        "collections": [],
        "count": 0,
        "n_collections": 0
      }
    },
    "query_knowledge_hub_empty_query": {
      "is_error": true,
      "message": "'query' is required and must be a non-empty string"
    }
  },
  "tool_schemas": {
    "get_document": {
      "description": "Return read-only metadata for a document (by its document_id) from an authorized SKDY knowledge base, including its title, summary, tags, source and chunk count.",
      "input_schema": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "document_id"
            ]
          },
          {
            "required": [
              "doc_id"
            ]
          }
        ],
        "properties": {
          "doc_id": {
            "description": "Deprecated alias for `document_id`.",
            "type": "string"
          },
          "document_id": {
            "description": "The stable document UUID.",
            "type": "string"
          }
        },
        "required": [
          "document_id"
        ],
        "type": "object"
      },
      "name": "get_document",
      "output_schema": {
        "properties": {
          "chunk_count": {
            "type": "integer"
          },
          "collection": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "document_type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "summary",
          "tags",
          "source",
          "doc_type",
          "chunk_count"
        ],
        "type": "object"
      }
    },
    "get_document_summary": {
      "description": "Compatibility alias of get_document. Return read-only metadata for a document by its legacy doc_id.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "description": "The document id (= source_ref on every chunk). Matches the parent Document.id generated at ingest.",
            "type": "string"
          }
        },
        "required": [
          "doc_id"
        ],
        "type": "object"
      },
      "name": "get_document_summary",
      "output_schema": {
        "properties": {
          "chunk_count": {
            "type": "integer"
          },
          "collection": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "document_type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "summary",
          "tags",
          "source",
          "doc_type",
          "chunk_count"
        ],
        "type": "object"
      }
    },
    "list_collections": {
      "description": "List knowledge bases authorized for the current MCP API key. Each entry includes its collection name, business description, and document / chunk counts.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "list_collections",
      "output_schema": {
        "properties": {
          "collections": {
            "items": {
              "properties": {
                "chunk_count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "document_count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "type": "integer"
          },
          "n_collections": {
            "description": "Deprecated alias for `count`.",
            "type": "integer"
          }
        },
        "required": [
          "count",
          "collections"
        ],
        "type": "object"
      }
    },
    "query_knowledge_hub": {
      "description": "Search an authorized SKDY knowledge base and return ranked retrieval evidence (chunks + citations). Returns NO answer — the evidence is for your own synthesis. Use list_collections first to identify the collection name.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "collection": {
            "default": "default",
            "description": "Collection name (= BM25 index name) to query.",
            "type": "string"
          },
          "no_rerank": {
            "default": false,
            "description": "Deprecated alias for `rerank`. Use `rerank` instead.",
            "type": "boolean"
          },
          "query": {
            "description": "The text to retrieve evidence for. Up to 2000 characters.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "rerank": {
            "default": true,
            "description": "Whether to apply the optional rerank stage when one is configured. Highly recommended for precision.",
            "type": "boolean"
          },
          "top_k": {
            "default": 10,
            "description": "Maximum number of evidence results to return.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "query_knowledge_hub",
      "output_schema": {
        "properties": {
          "citations": {
            "description": "Deprecated alias for `evidence`.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "collection": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "diagnostics": {
            "properties": {
              "degraded": {
                "type": "boolean"
              },
              "reasons": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "trace_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "degraded",
              "reasons"
            ],
            "type": "object"
          },
          "evidence": {
            "items": {
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "rank": {
                  "type": "integer"
                },
                "score": {
                  "type": "number"
                },
                "source": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "rank",
                "chunk_id",
                "document_id",
                "source",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "n_results": {
            "description": "Deprecated alias for `count`.",
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "collection",
          "count",
          "evidence",
          "diagnostics"
        ],
        "type": "object"
      }
    }
  }
}
