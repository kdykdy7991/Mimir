# Browser requests stay on the Web UI origin and are proxied by Next.js.
INTERNAL_API_BASE_URL=http://127.0.0.1:8766

# Displayed on /mcp-keys and embedded in generated MCP Client configuration.
# Use the public HTTPS reverse-proxy URL in production.
NEXT_PUBLIC_MCP_SERVER_URL=http://127.0.0.1:8765/mcp
